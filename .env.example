# Public Supabase values only. Never put service-role keys or provider secrets
# in VITE_* variables: Vite embeds them into the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Configure this in the Supabase Edge Function environment, not in the client.
# ALLOWED_ORIGINS=https://your-production-domain.example
